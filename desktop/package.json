{
  "name": "filmfrei24",
  "productName": "FilmFrei24",
  "version": "1.0.0",
  "description": "FilmFrei24 für Windows und Linux",
  "main": "main.js",
  "author": "FilmFrei24",
  "license": "UNLICENSED",
  "scripts": { "dist:win": "electron-builder --win nsis --publish never", "dist:linux": "electron-builder --linux AppImage --publish never" },
  "devDependencies": { "electron": "33.2.1", "electron-builder": "25.1.8" },
  "build": {
    "appId": "com.filmfrei24.desktop",
    "productName": "FilmFrei24",
    "artifactName": "FilmFrei24-Setup.${ext}",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "icon.png"],
    "protocols": [{ "name": "FilmFrei24", "schemes": ["filmfrei24"] }],
    "win": { "target": "nsis", "icon": "icon.png" },
    "nsis": { "oneClick": true, "perMachine": false, "shortcutName": "FilmFrei24", "createDesktopShortcut": true, "runAfterFinish": true },
    "linux": { "target": "AppImage", "icon": "icon.png", "category": "Video" }
  }
}
